{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/digows/agentic-skills/blob/main/schemas/upstream-skill.schema.json",
  "title": "Federated upstream skill entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "category",
    "facets",
    "risk",
    "description",
    "source",
    "files",
    "compatibility"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "status": { "enum": ["draft", "published", "deprecated"] },
    "category": { "type": "string" },
    "facets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "risk": { "enum": ["low", "moderate", "high", "critical"] },
    "description": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "license", "reviewed_at"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source_path", "sha256", "size_bytes", "content_type"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
          "source_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "content_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatibility": { "type": "array" }
  }
}
