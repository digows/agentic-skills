{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/digows/agentic-skills/blob/main/schemas/catalog.schema.json",
  "title": "Agentic Skills catalogue sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "category",
    "facets",
    "risk",
    "source",
    "requirements",
    "compatibility",
    "evaluations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "status": { "enum": ["draft", "published", "deprecated"] },
    "category": { "type": "string" },
    "facets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "risk": { "enum": ["low", "moderate", "high", "critical"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "reviewed_at"],
      "properties": {
        "upstream": { "type": "string", "format": "uri" },
        "reviewed_at": { "type": "string", "format": "date" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials", "network_access", "tools"],
      "properties": {
        "credentials": { "type": "array", "items": { "type": "string" } },
        "network_access": { "type": "boolean" },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "target_binding", "prompting", "failure_behavior"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "target_binding": { "const": "exact-target" },
        "prompting": { "const": "when-missing-or-invalid" },
        "failure_behavior": { "const": "stop" }
      }
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["harness", "version", "verified_at", "result"],
        "properties": {
          "harness": { "type": "string" },
          "version": { "type": "string" },
          "verified_at": { "type": "string", "format": "date" },
          "result": { "enum": ["pass", "partial", "fail"] }
        }
      }
    },
    "evaluations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "baseline_report", "skill_report"],
      "properties": {
        "definition": { "type": "string", "pattern": "^evals/.+\\.json$" },
        "baseline_report": { "type": "string" },
        "skill_report": { "type": "string" }
      }
    }
  }
}
